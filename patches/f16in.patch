+# fp16-input forward (this build): the caller's fp16 Q, K, V go to the PV fp16acc forward as they
+# are, O comes back in bf16, and the backward takes the same fp16 tensors. The op returns only what
+# the backward reads: torch's activation-budget partitioner prices a node at the sum of its outputs.
+@_torch_custom_op_wrapper("flash_attn::_flash_attn_forward_f16in", mutates_args=(), device_types="cuda")
+def _flash_attn_forward_f16in(
+    q: torch.Tensor, k: torch.Tensor, v: torch.Tensor, softmax_scale: float
+) -> Tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    q, k, v = [maybe_contiguous(x) for x in (q, k, v)]
+    out = torch.empty_like(q, dtype=torch.bfloat16)
+    out, softmax_lse, _, rng_state = flash_attn_gpu.fwd(
+        q, k, v, out, None, 0.0, softmax_scale, False, -1, -1, 0.0, False, None
+    )
+    return out, softmax_lse, rng_state
+
+
+@_torch_register_fake_wrapper("flash_attn::_flash_attn_forward_f16in")
+def _flash_attn_forward_f16in_fake(
+    q: torch.Tensor, k: torch.Tensor, v: torch.Tensor, softmax_scale: float
+) -> Tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    batch_size, seqlen_q, num_heads, _ = q.shape
+    out = torch.empty_like(q, dtype=torch.bfloat16)
+    softmax_lse = torch.empty((batch_size, num_heads, seqlen_q), dtype=torch.float32, device=q.device)
+    rng_state = torch.empty((2,), dtype=torch.int64, device=q.device)
+    return out, softmax_lse, rng_state
+
+
+if torch.__version__ >= "2.4.0":
+    _wrapped_flash_attn_forward_f16in = torch.ops.flash_attn._flash_attn_forward_f16in
+else:
+    _wrapped_flash_attn_forward_f16in = _flash_attn_forward_f16in
+
+
+class FlashAttnF16inFunc(torch.autograd.Function):
+    @staticmethod
+    def forward(ctx, q, k, v, softmax_scale):
+        # Under torch.compile this forward is traced, so the casts fuse into whatever made q, k, v.
+        q16, k16, v16 = (x.to(torch.float16) for x in (q, k, v))
+        out, softmax_lse, rng_state = _wrapped_flash_attn_forward_f16in(q16, k16, v16, softmax_scale)
+        ctx.save_for_backward(q16, k16, v16, out, softmax_lse, rng_state)
+        ctx.softmax_scale = softmax_scale
+        return out
+
+    @staticmethod
+    def backward(ctx, dout):
+        q16, k16, v16, out, softmax_lse, rng_state = ctx.saved_tensors
+        dq, dk, dv = (torch.empty_like(x, dtype=out.dtype) for x in (q16, k16, v16))
+        _wrapped_flash_attn_backward(
+            dout, q16, k16, v16, out, softmax_lse, dq, dk, dv,
+            0.0, ctx.softmax_scale, False, -1, -1, 0.0, None, False, rng_state=rng_state,
+        )
+        return dq, dk, dv, None
+
+
+# Read once at import, so a compiled caller does not trace an environment lookup.
+_F16IN_ENABLED = (
+    os.environ.get("FLASH_ATTN_FP16ACC", "")[:1] != "0"
+    and os.environ.get("FLASH_ATTN_FP16ACC_FWD", "")[:1] != "0"
+)
+
+
+def flash_attn_f16in_takes(q, k, v):
+    """Whether flash_attn_f16in_func takes these inputs: head dim 128 and as many K/V heads as Q
+    heads, with neither FLASH_ATTN_FP16ACC=0 nor FLASH_ATTN_FP16ACC_FWD=0 set at import."""
+    return (
+        _F16IN_ENABLED and q.shape[-1] == 128
+        and k.shape[-2] == q.shape[-2] and v.shape[-2] == q.shape[-2]
+    )
+
+
+def flash_attn_f16in_func(q, k, v, softmax_scale=None):
+    """Non-causal attention without dropout on (batch, seqlen, nheads, 128) q, k, v of any float
+    dtype: they are cast to fp16 here (fused into their producer under torch.compile), and the
+    fp16-accumulate forward and backward take those copies without casting again. Returns bf16;
+    gradients come back in bf16 (autograd casts them to the inputs' dtype). Calls that
+    flash_attn_f16in_takes refuses go to flash_attn_func."""
+    if softmax_scale is None:
+        softmax_scale = q.shape[-1] ** (-0.5)
+    if not flash_attn_f16in_takes(q, k, v):
+        return flash_attn_func(q, k, v, softmax_scale=softmax_scale)
+    return FlashAttnF16inFunc.apply(q, k, v, softmax_scale)
