+// dot_do_o for the fp16acc kernels: do_ and o hold bf16 bits on entry, do_ holds the scaled fp16
+// values on return, and dP_sum is in the scaled units.
+template <int THREADS_PER_ROW, typename Engine0, typename Layout0, typename Engine1, typename Layout1>
+inline __device__ void dot_do_o_fp16acc(Tensor<Engine0, Layout0> &do_, Tensor<Engine0, Layout0> const &o,
+                                        Tensor<Engine1, Layout1> &dP_sum, const int gdP_col_stride, const float do_scale) {
+    static_assert(Layout0::rank == 3, "Only support 3D Tensor");
+    static_assert(Layout1::rank == 1, "Only support 1D Tensor");
+    Tensor do_reshaped = make_tensor(do_.data(), make_layout(get<1>(do_.layout()),
+                                                             make_layout(get<0>(do_.layout()),
+                                                                         get<2>(do_.layout()))));
+    Tensor do_bf16 = make_tensor(make_rmem_ptr<cutlass::bfloat16_t>(do_.data()), do_reshaped.layout());
+    Tensor o_bf16 = make_tensor(make_rmem_ptr<cutlass::bfloat16_t>(o.data()), do_reshaped.layout());
+    Tensor do_fp32 = FLASH_NAMESPACE::convert_type<float>(do_bf16);
+    Tensor o_fp32 = FLASH_NAMESPACE::convert_type<float>(o_bf16);
+    const float inv = 1.f / do_scale;
+    #pragma unroll
+    for (int mi = 0; mi < size<0>(do_reshaped); ++mi) {
+        float dP_sum_cur = 0.f;
+        #pragma unroll
+        for (int ni = 0; ni < size<1>(do_reshaped); ni++) {
+            do_fp32(mi, ni) *= inv;
+            dP_sum_cur += do_fp32(mi, ni) * o_fp32(mi, ni);
+        }
+        FLASH_NAMESPACE::SumOp<float> sum_op;
+        dP_sum_cur = FLASH_NAMESPACE::Allreduce<THREADS_PER_ROW>::run(dP_sum_cur, sum_op);
+        if (threadIdx.x % THREADS_PER_ROW == 0) {
+            dP_sum(mi * gdP_col_stride + threadIdx.x / THREADS_PER_ROW) = dP_sum_cur;
+        }
+    }
+    Tensor do_half = FLASH_NAMESPACE::convert_type<typename Engine0::value_type>(do_fp32);
+    #pragma unroll
+    for (int i = 0; i < size(do_reshaped); ++i) { do_reshaped(i) = do_half(i); }
