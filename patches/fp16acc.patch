+void run_mha_bwd_fp16acc(Flash_bwd_params &params, cudaStream_t stream) {
+    int device;
+    cudaGetDevice(&device);
+    int max_smem_per_block;
+    cudaError status_ = cudaDeviceGetAttribute(
+        &max_smem_per_block, cudaDevAttrMaxSharedMemoryPerBlockOptin, device);
+    if (status_ != cudaSuccess) {
+      C10_CUDA_CHECK(status_);
+    }
+    if (max_smem_per_block >= 144 * 1024) {
+        run_flash_bwd_fp16acc<Flash_bwd_fp16acc_kernel_traits<128, 64, 128, 8, 2, 4, 2, false, false>>(params, stream);
+    } else {
+        run_flash_bwd_fp16acc<Flash_bwd_fp16acc_kernel_traits<128, 64, 64, 8, 4, 2, 2, true, false>>(params, stream);
+    }
+}
+
+} // namespace FLASH_NAMESPACE
