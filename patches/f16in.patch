--- a/csrc/flash_attn/src/flash_bwd_hdim128_fp16acc_sm80.cu
+++ b/csrc/flash_attn/src/flash_bwd_hdim128_fp16acc_sm80.cu
@@ -4,6 +4,43 @@
 
 namespace FLASH_NAMESPACE {
 
+// max |dO| over (seqlen, head_dim) for each (batch, head), into out[b * h + hh], which the caller
+// fills with the floor value first. dO is a contiguous bf16 [b, s, h, d] with d a multiple of 8;
+// Each block reads blockDim.x / d8 rows at a time (d8 <= blockDim.x), blockIdx.y splits the rows,
+// and non-negative floats order like their int bits for atomicMax.
+__global__ void amax_abs_bh_kernel(const uint4 *__restrict__ dout, int *__restrict__ out,
+                                   const int s, const int h, const int d8) {
+    const int b = blockIdx.x / h, hh = blockIdx.x % h;
+    const int rows = blockDim.x / d8, r0 = threadIdx.x / d8, c = threadIdx.x % d8;
+    float m = 0.f;
+    if (r0 < rows) {
+        for (int row = blockIdx.y * rows + r0; row < s; row += gridDim.y * rows) {
+            const long long base = (static_cast<long long>(b) * s + row) * h + hh;
+            const uint4 u = dout[base * d8 + c];
+            const unsigned w[4] = {u.x, u.y, u.z, u.w};
+            #pragma unroll
+            for (int i = 0; i < 4; ++i) {
+                // bf16 -> fp32 is a shift; clear the sign for |x|
+                m = fmaxf(m, __uint_as_float((w[i] << 16) & 0x7fffffffu));
+                m = fmaxf(m, __uint_as_float(w[i] & 0x7fff0000u));
+            }
+        }
+    }
+    #pragma unroll
+    for (int o = 16; o > 0; o >>= 1) { m = fmaxf(m, __shfl_xor_sync(0xffffffff, m, o)); }
+    if ((threadIdx.x & 31) == 0) { atomicMax(out + blockIdx.x, __float_as_int(m)); }
+}
+
+void amax_abs_bh(const void *dout_bf16, float *out, int b, int s, int h, int d, cudaStream_t stream) {
+    const int d8 = d / 8;  // 16 at head dim 128, 8 at 64
+    const int threads = 256;
+    const int rows_per_block = threads / d8;
+    const int ysplit = std::min(64, (s + rows_per_block - 1) / rows_per_block);
+    amax_abs_bh_kernel<<<dim3(b * h, ysplit), threads, 0, stream>>>(
+        static_cast<const uint4 *>(dout_bf16), reinterpret_cast<int *>(out), s, h, d8);
+    C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
+
