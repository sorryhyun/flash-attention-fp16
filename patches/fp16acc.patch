@@ -237,6 +237,23 @@ __forceinline__ __device__ auto convert_type(Tensor<Engine, Layout> const &tenso
 
 ////////////////////////////////////////////////////////////////////////////////////////////////////
 
+// fp16acc: bf16 results travel through the half_t smem and gmem paths as raw 16-bit values.
+template <typename To_type, typename Bits_type, typename Engine, typename Layout>
+__forceinline__ __device__ auto convert_type_bits(Tensor<Engine, Layout> const &tensor) {
+    using From_type = typename Engine::value_type;
+    constexpr int numel = decltype(size(tensor))::value;
+    cutlass::NumericArrayConverter<To_type, From_type, numel> convert_op;
+    auto frag = convert_op(*reinterpret_cast<const cutlass::Array<From_type, numel> *>(tensor.data()));
+    return make_tensor(make_rmem_ptr<Bits_type>(&frag), tensor.layout());
+}
+
+// acc += a16; both are fragments of the same layout
+template <typename Engine0, typename Engine1, typename Layout>
+__forceinline__ __device__ void add_fp16_accum(Tensor<Engine0, Layout> &acc, Tensor<Engine1, Layout> const &a16) {
+    #pragma unroll
+    for (int i = 0; i < size(acc); ++i) { acc(i) += static_cast<float>(a16(i)); }
+}
