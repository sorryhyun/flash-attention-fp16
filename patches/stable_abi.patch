 namespace FLASH_NAMESPACE {
 
+namespace {
+
+bool has_shape(const Tensor& t, std::initializer_list<int64_t> shape) {
+    if (t.dim() != static_cast<int64_t>(shape.size())) { return false; }
+    int64_t i = 0;
+    for (const int64_t s : shape) {
+        if (t.size(i++) != s) { return false; }
+    }
+    return true;
+}
+
+cudaStream_t current_stream() {
+    void* stream = nullptr;
+    STABLE_TORCH_ERROR_CODE_CHECK(aoti_torch_get_current_cuda_stream(
+        tsa::getCurrentDeviceIndex(), &stream));
+    return static_cast<cudaStream_t>(stream);
+}
+
+// aten ops without a torch::stable wrapper, called through the dispatcher.
+template <size_t N>
+Tensor call_aten(const char* name, const char* overload, std::array<StableIValue, N> stack) {
+    STABLE_TORCH_ERROR_CODE_CHECK(torch_call_dispatcher(name, overload, stack.data(), TORCH_ABI_VERSION));
+    return torch::stable::detail::to<Tensor>(stack[0]);
+}
+
+Tensor abs_tensor(const Tensor& t) {
+    return call_aten<1>("aten::abs", "", {torch::stable::detail::from(t)});
+}
+
+Tensor clamp_min_tensor(const Tensor& t, double min) {
+    Tensor min_t = torch::stable::new_empty(t, {}, t.scalar_type());
+    torch::stable::fill_(min_t, min);
+    return call_aten<2>("aten::clamp_min", "Tensor",
+                        {torch::stable::detail::from(t), torch::stable::detail::from(min_t)});
+}
